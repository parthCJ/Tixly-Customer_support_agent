# Tixly Customer Support - Environment Configuration

# ============================================================
# AI/LLM Configuration
# ============================================================

# Groq API Key (Get from: https://console.groq.com/)
# Used for both standard AI and CrewAI agents
GROQ_API_KEY=your_groq_api_key_here

# ============================================================
# CrewAI Multi-Agent System
# ============================================================

# Enable CrewAI multi-agent processing (true/false)
# - true: Uses 4-agent workflow (Triage → KB → Response → QA)
# - false: Uses standard single-agent AI classifier
# Default: false
USE_CREWAI=false

# ============================================================
# CORS Configuration
# ============================================================

# Frontend URL for CORS
# Example: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:3000

# Multiple allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.com

# ============================================================
# Database Configuration (Optional - Future)
# ============================================================

# DATABASE_URL=postgresql://user:password@localhost:5432/tixly
# REDIS_URL=redis://localhost:6379

# ============================================================
# ChromaDB Configuration
# ============================================================

# ChromaDB will use local storage by default
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# ============================================================
# Performance & Limits
# ============================================================

# Maximum concurrent AI processing tasks
# MAX_CONCURRENT_AI_TASKS=5

# Ticket processing timeout (seconds)
# TICKET_PROCESSING_TIMEOUT=30

# ============================================================
# Logging
# ============================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# ============================================================
# Development Settings
# ============================================================

# Development mode (enables debug features)
# DEV_MODE=true

# Port for backend server
# PORT=8000
